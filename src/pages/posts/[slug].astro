---
// One page per article in src/content/posts/.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { loadPosts, tagHref, type Post } from '../../lib/content';
import { ITEMS } from '../../lib/scene';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const posts = await loadPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post.entry);
const it = post.item ? ITEMS[post.item] : undefined;
const comments = !!(site.giscus && site.giscus.repoId && site.giscus.categoryId);
const toc2 = headings.filter((h) => h.depth === 2 || h.depth === 3);
// long guides: list only the chapters, or the contents box gets longer than a screen
const toc = toc2.length > 24 ? toc2.filter((h) => h.depth === 2) : toc2;
// typeset formulas only where an article has them
const hasMath = /\$[^$\n]+\$/.test(post.entry.body ?? '');

// newer / older article on the same object (posts are newest first)
const all = await loadPosts();
const siblings = all.filter((p) => p.item === post.item);
const i = siblings.findIndex((p) => p.slug === post.slug);
const newer = i > 0 ? siblings[i - 1] : null;
const older = i >= 0 && i < siblings.length - 1 ? siblings[i + 1] : null;
// related: most shared tags anywhere else
const related = all
  .filter((p) => p.slug !== post.slug && p !== newer && p !== older)
  .map((p) => ({ p, n: p.tags.filter((t) => post.tags.includes(t)).length }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n || b.p.date.valueOf() - a.p.date.valueOf())
  .slice(0, 3)
  .map((x) => x.p);
---

<Base title={post.title} description={post.summary || undefined} here={post.item}>
  <div class="read-progress" aria-hidden="true"><i></i></div>
  {hasMath && <link rel="stylesheet" href="/katex/katex.min.css" />}
  <main class="page-view wrap">
    <div class={toc.length > 1 ? 'page post-page has-toc' : 'page post-page'}>
      <PageHead item={post.item} />
      <article class="post sheet" data-pagefind-body>
        <h1>{post.title}</h1>
        <p class="post-meta">
          <time datetime={post.date.toISOString().slice(0, 10)}>{post.date.getUTCFullYear()} 年 {post.dateLabel}</time>
          <span class="post-min"> · 约 {post.minutes} 分钟读完</span>
          {post.tags.map((t) => <Fragment> · <a class="post-tag" href={tagHref(t)}>#{t}</a></Fragment>)}
        </p>
        {post.sample && <p class="page-sample" data-pagefind-ignore>示例文章，正式写作时替换或删除。</p>}
        {
          toc.length > 1 && (
            <nav class="toc-wrap" aria-label="目录" data-pagefind-ignore>
              <details class="toc" data-toc open>
                <summary class="toc-title">目录 <small>{toc.filter((h) => h.depth === 2).length} 节</small></summary>
                <ol>
                  {toc.map((h) => (
                    <li class={h.depth === 3 ? 'is-sub' : undefined}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </details>
              {/* phones: start folded so the article is on the first screen */}
              <script is:inline>
                if (window.matchMedia('(max-width: 760px)').matches) document.querySelector('[data-toc]')?.removeAttribute('open');
              </script>
            </nav>
          )
        }
        <div class="post-body">
          <Content />
        </div>
      </article>

      {
        (newer || older) && (
          <nav class="post-nav" aria-label="同一处的上一篇和下一篇">
            {older ? <a class="post-nav-link" href={older.href}><small>‹ 更早一篇</small>{older.title}</a> : <span />}
            {newer ? <a class="post-nav-link is-next" href={newer.href}><small>更新一篇 ›</small>{newer.title}</a> : <span />}
          </nav>
        )
      }
      {
        related.length > 0 && (
          <section class="post-related" aria-label="相关文章">
            <h2 class="post-comments-title">相关文章</h2>
            <ul>
              {related.map((p) => (
                <li><a href={p.href}>{p.title}</a><small>{p.dateLabel}</small></li>
              ))}
            </ul>
          </section>
        )
      }
      {
        comments && (
          <section class="post-comments" aria-label="留言">
            <h2 class="post-comments-title">留言</h2>
            <div data-giscus-term={`post:${post.slug}`}></div>
          </section>
        )
      }
      {it ? <a class="page-back" href={`/#${it.id}`}>‹ 回到树屋 · {it.name}</a> : <a class="page-back" href="/">‹ 回到树屋</a>}
    </div>
  </main>
</Base>

<script>
  // Reading progress along the top, and a copy button on every code block.
  const bar = document.querySelector<HTMLElement>('.read-progress i');
  const article = document.querySelector<HTMLElement>('.post');
  if (bar && article) {
    const update = () => {
      const r = article.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const done = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
      bar.style.transform = `scaleX(${done})`;
    };
    document.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
  // Wide screens: the contents sit beside the article; mark the chapter you are reading.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const heads = Array.from(byId.keys()).map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.removeAttribute('aria-current'));
          byId.get(e.target.id)?.setAttribute('aria-current', 'true');
        });
      },
      { rootMargin: '-10% 0px -80% 0px' },
    );
    heads.forEach((h) => io.observe(h));
  }
  document.querySelectorAll<HTMLPreElement>('.post-body pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-code';
    btn.textContent = '复制';
    btn.addEventListener('click', async () => {
      const text = pre.querySelector('code')?.innerText ?? pre.innerText;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = '已复制';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        btn.textContent = '请按 Ctrl+C';
      }
      setTimeout(() => (btn.textContent = '复制'), 1600);
    });
    pre.classList.add('has-copy');
    pre.appendChild(btn);
  });
</script>
