---
// The interactive treehouse. Markup must stay in step with tools/render.py (the no-Node preview).
import '../styles/treehouse.css';
import data from '../data/treehouse.json';
import site from '../data/site.json';
import { buildPanels, searchIndex } from '../lib/content';

const IMG = '/treehouse/';
const W = data.scene.w;
const H = data.scene.h;
const NOTE_PATH = 'M9 18.2a3 3 0 1 1-2-2.8V5.2l11-2.1v11a3 3 0 1 1-2-2.8V6.6l-7 1.4z';

// Lines of "code" on the two monitors (width %, indent %), repeated twice for a seamless scroll.
const CODE = [[72, 0], [46, 10], [84, 10], [30, 20], [62, 10], [90, 0], [40, 10], [76, 20], [55, 10], [34, 0]];
const codeLines = [...CODE, ...CODE];

// Monitor screens in scene pixels, placed relative to the desk layer.
const SCREENS = [[302, 929, 61, 40], [376, 928, 59, 40]];
const deskBox = data.layers.find((l) => l.key === 'desk')?.box ?? [0, 0, 100, 100];
const dx = (deskBox[0] / 100) * W;
const dy = (deskBox[1] / 100) * H;
const dw = (deskBox[2] / 100) * W;
const dh = (deskBox[3] / 100) * H;
const pct = (v: number, total: number) => Math.round((v / total) * 10000) / 100;
const screens = SCREENS.map(([x, y, w, h]) => `left:${pct(x - dx, dw)}%;top:${pct(y - dy, dh)}%;width:${pct(w, dw)}%;height:${pct(h, dh)}%`);

const stars = data.stars.map((s, i) => {
  const d = -((i * 0.73) % 3.1);
  const t = 2.6 + ((i * 0.37) % 1.6);
  return `left:${s.x}%;top:${s.y}%;--d:${d.toFixed(2)}s;--t:${t.toFixed(2)}s`;
});

// What every object shows when the camera moves in (built from src/content/).
const { panels, posts } = await buildPanels();

// Escape "<" so the JSON can never close its <script> tag early.
const cardData = JSON.stringify({
  scene: data.scene,
  items: data.items,
  floors: data.floors,
  panels,
  posts: searchIndex(posts),
}).replace(/</g, '\\u003c');
---

<div class="th-scene" id="th-scene">
  <div class="th-stage">
    <img
      class="th-base th-base-day"
      src={`${IMG}day-clear.webp`}
      width="1086"
      height="1448"
      draggable="false"
      alt="一棵秋天的大树上搭着两层树屋：楼上是起居室，楼下是工作坊，树冠上有望远镜和小红旗，树下立着木牌和信箱。"
    />
    <img class="th-base th-base-night" src={`${IMG}night-clear.webp`} width="1086" height="1448" draggable="false" alt="" aria-hidden="true" />
    <span class="th-moon" aria-hidden="true"></span>
    {stars.map((style) => <span class="th-star" style={style} aria-hidden="true"></span>)}

    {
      data.layers.map((L) => (
        <div
          class={L.cut ? 'th-layer' : 'th-layer no-lift'}
          data-key={L.key}
          data-item={L.item}
          style={`left:${L.box[0]}%;top:${L.box[1]}%;width:${L.box[2]}%;height:${L.box[3]}%;--o:${L.origin};--sc:${L.scale}`}
        >
          {L.cut &&
            ['day', 'night'].map((m) => (
              <img class={`th-cut th-cut-${m}`} src={`${IMG}cut/${m}/${L.key}.webp`} alt="" decoding="async" draggable="false" />
            ))}

          {L.key === 'lights' && (
            <Fragment>
              <svg class="th-nn" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                {data.links.map((k) => (
                  <line x1={k.x1} y1={k.y1} x2={k.x2} y2={k.y2} pathLength="100" style={`--col:${k.col}`} />
                ))}
              </svg>
              {data.bulbs.map((b) => (
                <span class="th-bulb" style={`left:${b.x}%;top:${b.y}%;--col:${b.col}`}></span>
              ))}
            </Fragment>
          )}

          {L.extra === 'desk' &&
            screens.map((style, i) => (
              <div class={i ? 'th-screen is-second' : 'th-screen'} style={style}>
                <div class="th-code">
                  {codeLines.map(([width, indent]) => (
                    <span style={`width:${width}%;margin-left:${indent}%`}></span>
                  ))}
                </div>
              </div>
            ))}

          {L.extra === 'owl' && (
            <Fragment>
              <span class="th-eye" style="left:27.27%;top:27.03%"><span class="th-lid"></span></span>
              <span class="th-eye" style="left:50.91%;top:27.03%"><span class="th-lid"></span></span>
            </Fragment>
          )}

          {L.extra === 'lamp' && <span class="th-glow"></span>}

          {L.extra === 'record' &&
            [0, 1, 2].map(() => (
              <svg class="th-note" viewBox="0 0 24 24" aria-hidden="true">
                <path d={NOTE_PATH} fill="currentColor"></path>
              </svg>
            ))}

          {L.extra === 'sign' && <span class="th-sign-text">{site.name}</span>}

          <button
            class="th-hit"
            type="button"
            data-item={L.item}
            aria-label={L.label}
            aria-controls="th-card"
            aria-expanded="false"
            style={L.hit ? `inset:auto;left:${L.hit[0]}%;top:${L.hit[1]}%;width:${L.hit[2]}%;height:${L.hit[3]}%` : undefined}
          >
            <span class={L.tip === 'below' ? 'th-tip below' : 'th-tip'} aria-hidden="true">{L.name}</span>
          </button>
        </div>
      ))
    }

    <div class="th-leaves" aria-hidden="true"></div>
  </div>

  <button class="th-zoom-out" type="button">回到全景</button>

  <div class="th-card" id="th-card" role="dialog" aria-labelledby="th-card-title" hidden>
    <button class="th-card-close" type="button" aria-label="关闭">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
      </svg>
    </button>
    <p class="th-card-kicker"></p>
    <h2 class="th-card-title" id="th-card-title" tabindex="-1"></h2>
    <p class="th-card-desc"></p>
    <div class="th-card-extra"></div>
    <a class="th-card-go" href="#">去看看</a>
  </div>
</div>

<script is:inline type="application/json" id="th-data" set:html={cardData}></script>

<script>
  import '../scripts/treehouse.js';
</script>
